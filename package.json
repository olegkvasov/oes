{
  "name": "dispatch-console",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "mock": "node --import tsx mock/server.ts",
    "check": "vue-tsc --noEmit && yarn lint && node scripts/check-architecture.mjs && node scripts/check-layout.mjs && yarn format:check",
    "test": "vitest run --config tests/vitest.config.ts",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "e2e": "node tests/e2e/run.mjs",
    "perf": "node --import tsx tests/performance/run.ts"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "pinia": "^3.0.0",
    "fastify": "^5.0.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "vue-tsc": "^3.0.0",
    "tsx": "^4.0.0",
    "vitest": "^3.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.0.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "eslint-plugin-vue": "^10.5.0",
    "vue-eslint-parser": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "3.6.2"
  },
  "packageManager": "yarn@1.22.22"
}
